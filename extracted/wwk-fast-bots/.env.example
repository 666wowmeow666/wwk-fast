# ===== Telegram =====
CLIENT_BOT_TOKEN=            # токен WWK FAST CLIENT от @BotFather
TEAM_BOT_TOKEN=              # токен WWK FAST TEAM от @BotFather
ADMIN_TELEGRAM_IDS=          # Telegram ID первых админов через запятую, например 123456789

# ===== База данных (PostgreSQL) =====
DATABASE_URL=                # postgresql://user:password@host:5432/dbname
RUN_MIGRATIONS=1             # 1 = применять миграции при старте

# ===== CRM 4logist =====
CRM_MODE=mock                # mock | real
CRM_BASE_URL=https://wwkfast.4logist.com
CRM_CLIENT_ID=               # OAuth Client ID из 4logist
CRM_CLIENT_SECRET=           # OAuth Client Secret из 4logist (секрет)
CRM_USERNAME=                # логин пользователя 4logist
CRM_PASSWORD=                # пароль пользователя 4logist (секрет)
# Необязательный legacy-вариант: готовый access_token, истекающий через expires_in.
# Для постоянной работы используйте четыре OAuth-переменные выше.
CRM_TOKEN=
CRM_AUTH_HEADER=Authorization   # только для legacy CRM_TOKEN
CRM_AUTH_SCHEME=Bearer          # только для legacy CRM_TOKEN
CRM_TIMEOUT_SECONDS=15
CRM_MAX_READ_RETRIES=2
CRM_ALLOW_WRITES=0           # 0 = записи в CRM запрещены (безопасный режим)

# ===== Клиентский бот: проверка и доступ =====
CLIENT_MAX_FAILS_PER_TELEGRAM=5
CLIENT_MAX_FAILS_PER_ORDER=10
CLIENT_LOCKOUT_MINUTES=30
CLIENT_BINDING_TTL_DAYS=180
CLIENT_REQUIRE_MANAGER_APPROVAL=0   # 1 = привязку подтверждает менеджер
CLIENT_VISIBLE_DOC_GROUPS=          # ID/названия групп документов, видимых клиенту (пусто = документы скрыты)
CLIENT_MAX_DOCUMENT_MB=20

# ===== О компании (показывается клиентам) =====
COMPANY_NAME=WWK FAST
COMPANY_PHONE=
COMPANY_REQUISITES=

# ===== Прочее =====
PORT=8080
LOG_LEVEL=INFO
